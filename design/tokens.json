  "material": {
    "bar": {
      "use": "候选栏 / AI 工具条 / 结果卡片底",
      "swiftUI": ".ultraThinMaterial",
      "blurRadius": 20,
      "tintRef": "color.light.chip.bg",
      "strokeWidth": 0.5,
      "strokeRef": "color.light.separator",
      "ios16Fallback": {
        "kind": "opaqueOverlay",
        "alpha": 0.94,
        "colorRef": "color.light.bg.surface"
      }
    },
    "card": {
      "use": "主 App 卡片 / 键盘内设置 Sheet 内容卡",
      "swiftUI": ".thinMaterial",
      "blurRadius": 24,
      "tintRef": "color.light.bg.glassTint",
      "strokeWidth": 0.5,
      "strokeRef": "color.light.separator",
      "ios16Fallback": {
        "kind": "opaqueOverlay",
        "alpha": 1.0,
        "colorRef": "color.light.bg.surface"
      }
    },
    "sheet": {
      "use": "键盘内设置 Sheet / 主 App sheet 背景",
      "swiftUI": ".regularMaterial",
      "blurRadius": 30,
      "tintRef": "color.light.bg.surface",
      "strokeWidth": 0,
      "strokeRef": "color.light.separator",
      "ios16Fallback": {
        "kind": "opaqueOverlay",
        "alpha": 1.0,
        "colorRef": "color.light.bg.surface"
      }
    },
    "highlight": {
      "use": "Liquid Glass 顶部高光（键帽、胶囊、卡片顶边）",
      "kind": "linearGradient",
      "colors": [
        "#FFFFFF40",
        "#FFFFFF00"
      ],
      "heightRatio": 0.45
    }
  }
