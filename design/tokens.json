    "card": {
      "y": 8,
      "blur": 24,
      "opacity": 0.12
    },
    "chip": {
      "y": 1,
      "blur": 4,
      "opacity": 0.08
    },
    "glass": {
      "y": 2,
      "blur": 16,
      "opacity": 0.1
    },
    "keyboard.top": {
      "y": -1,
      "blur": 0,
      "opacity": 0.08
    }
