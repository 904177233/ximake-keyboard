<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 墨语（Moyu）宿主 App Info.plist -->
	<!-- CFBundleIdentifier / CFBundleExecutable / CFBundleVersion 等由构建设置注入（$(VAR) 会被替换） -->

	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>

	<key>CFBundleDisplayName</key>
	<string>墨语</string>

	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>

	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>

	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>

	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>

	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<key>CFBundleIconName</key>
	<string>AppIcon</string>

	<key>LSRequiresIPhoneOS</key>
	<true/>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<key>UILaunchScreen</key>
	<dict/>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 墨语 Moyu. All rights reserved.</string>

	<key>NSPasteboardUsageDescription</key>
	<string>用于在「墨语」App 与键盘之间同步 AI 服务配置（不含 API Key）。</string>

	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>用于把 AI 生成的图片保存到你的相册。墨语只会在你点「保存到相册」时写入，不会读取你的照片。</string>


	<!-- ATS（App Transport Security）例外。
	     为什么需要：设置页允许用户填**任意** baseURL，包括自建中转常见的
	     `http://192.168.1.10:11434/v1`（Ollama/LM Studio/自建反代）。iOS 默认
	     禁止明文 HTTP，被拦时的表现是 `network` 错误、提示里只有「无法联网」，
	     用户会以为「API 配置好还是用不了」（真实用户反馈过）。
	     取舍：本 App 不上架 App Store（免费签名自签安装），所以用
	     `NSAllowsArbitraryLoads` 换「任意地址都能用」；如果将来上架，应改为
	     `NSExceptionDomains` 白名单 + 强制 https。 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDefault</string>

	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>